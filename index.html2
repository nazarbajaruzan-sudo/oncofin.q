                        </div>
                        <div class="flex justify-between border-b border-slate-700/60 pb-1">
                            <span class="text-slate-400">Ерте Анықталған Пациенттер:</span>
                            <span id="scen1EarlyCases" class="font-bold text-white">28,584 пациент</span>
                        </div>
                        <div class="flex justify-between border-b border-slate-700/60 pb-1">
                            <span class="text-slate-400">ҚР Таза Экономикалық Үнемі:</span>
                            <span id="scen1Savings" class="font-bold text-amber-300">17.25 млрд ₸</span>
                        </div>
                        <div class="flex justify-between border-b border-slate-700/60 pb-1">
                            <span class="text-slate-400">Сақталған Өмір Жылдары:</span>
                            <span id="scen1Qaly" class="font-bold text-amber-200">5,258 QALY</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-slate-400">Маңғыстау Өңірлік Үнемі:</span>
                            <span id="scen1MgSavings" class="font-bold text-white">0.51 млрд ₸</span>
                        </div>
                    </div>
                </div>

                <!-- Scenario 2: Baseline (Realistic) -->
                <div class="p-5 bg-slate-800/90 rounded-xl border border-teal-500 space-y-3 relative overflow-hidden shadow-lg shadow-teal-950/50">
                    <div class="absolute top-0 right-0 bg-teal-500 text-slate-900 text-[10px] font-extrabold px-3 py-1 rounded-bl">
                        2-Сценарий (Базалық)
                    </div>
                    <h4 class="text-base font-bold text-teal-300">Базалық / Шындыққа Жанасымды (+7.0%p)</h4>
                    <p class="text-[11px] text-slate-400">SmartQ жүйесінің негізгі күтілетін тиімділігі</p>
                    
                    <div class="space-y-2 pt-2 text-xs">
                        <div class="flex justify-between border-b border-slate-700/60 pb-1">
                            <span class="text-slate-400">Ерте Анықтау Дәрежесі:</span>
                            <span id="scen2EarlyRate" class="font-bold text-teal-300">62.8%</span>
                        </div>
                        <div class="flex justify-between border-b border-slate-700/60 pb-1">
                            <span class="text-slate-400">Ерте Анықталған Пациенттер:</span>
                            <span id="scen2EarlyCases" class="font-bold text-white">30,018 пациент</span>
                        </div>
                        <div class="flex justify-between border-b border-slate-700/60 pb-1">
                            <span class="text-slate-400">ҚР Таза Экономикалық Үнемі:</span>
                            <span id="scen2Savings" class="font-bold text-emerald-300">29.45 млрд ₸</span>
                        </div>
                        <div class="flex justify-between border-b border-slate-700/60 pb-1">
                            <span class="text-slate-400">Сақталған Өмір Жылдары:</span>
                            <span id="scen2Qaly" class="font-bold text-indigo-300">8,820 QALY</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-slate-400">Маңғыстау Өңірлік Үнемі:</span>
                            <span id="scen2MgSavings" class="font-bold text-teal-200">0.86 млрд ₸</span>
                        </div>
                    </div>
                </div>

                <!-- Scenario 3: Optimistic -->
                <div class="p-5 bg-slate-800/90 rounded-xl border border-emerald-500/40 space-y-3 relative overflow-hidden">
                    <div class="absolute top-0 right-0 bg-emerald-500 text-slate-900 text-[10px] font-extrabold px-3 py-1 rounded-bl">
                        3-Сценарий
                    </div>
                    <h4 class="text-base font-bold text-emerald-300">Оптимистік (+10.0%p)</h4>
                    <p class="text-[11px] text-slate-400">Скрининг қамтуы максималды деңгейге жеткенде</p>
                    
                    <div class="space-y-2 pt-2 text-xs">
                        <div class="flex justify-between border-b border-slate-700/60 pb-1">
                            <span class="text-slate-400">Ерте Анықтау Дәрежесі:</span>
                            <span id="scen3EarlyRate" class="font-bold text-emerald-300">65.8%</span>
                        </div>
                        <div class="flex justify-between border-b border-slate-700/60 pb-1">
                            <span class="text-slate-400">Ерте Анықталған Пациенттер:</span>
                            <span id="scen3EarlyCases" class="font-bold text-white">31,452 пациент</span>
                        </div>
                        <div class="flex justify-between border-b border-slate-700/60 pb-1">
                            <span class="text-slate-400">ҚР Таза Экономикалық Үнемі:</span>
                            <span id="scen3Savings" class="font-bold text-emerald-300">41.65 млрд ₸</span>
                        </div>
                        <div class="flex justify-between border-b border-slate-700/60 pb-1">
                            <span class="text-slate-400">Сақталған Өмір Жылдары:</span>
                            <span id="scen3Qaly" class="font-bold text-emerald-200">12,380 QALY</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-slate-400">Маңғыстау Өңірлік Үнемі:</span>
                            <span id="scen3MgSavings" class="font-bold text-white">1.22 млрд ₸</span>
                        </div>
                    </div>
                </div>

            </div>
        </section>

        <!-- Charts Section -->
        <section class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <!-- Multi-Scenario Epidemiological Trend Chart -->
            <div class="custom-card p-5">
                <h3 class="text-sm font-bold text-slate-800 mb-2 text-center">3 Сценарий Бойынша Ерте Анықтау Тренди (2018–2030)</h3>
                <div class="chart-container">
                    <canvas id="multiEarlyRateChart"></canvas>
                </div>
            </div>

            <!-- Savings Comparison Chart -->
            <div class="custom-card p-5">
                <h3 class="text-sm font-bold text-slate-800 mb-2 text-center">Сценарийлер Және Жылдар Бойынша Таза Үнем (Млрд KZT)</h3>
                <div class="chart-container">
                    <canvas id="multiSavingsChart"></canvas>
                </div>
            </div>
        </section>

        <!-- QALY Saved Chart Section -->
        <section class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <div class="custom-card p-5">
                <h3 class="text-sm font-bold text-slate-800 mb-2 text-center">3 Сценарий Бойынша Сақталған Сапалы Өмір Жылдары (QALY)</h3>
                <div class="chart-container">
                    <canvas id="qalyComparisonChart"></canvas>
                </div>
            </div>

            <div class="custom-card p-5">
                <h3 class="text-sm font-bold text-slate-800 mb-2 text-center">Cost-Effectiveness Plane (Dominant Strategy Analysis)</h3>
                <div id="plotlyIcePlaneMulti" class="w-full h-[320px]"></div>
            </div>
        </section>

        <!-- Comprehensive Multi-Scenario Table -->
        <section class="bg-white p-6 rounded-xl shadow-sm border border-slate-200 space-y-4">
            <h3 class="text-lg font-bold text-slate-900 border-b pb-2">3 Сценарий Бойынша Толық Салыстырмалы Болжам Кестесі (2026–2030)</h3>
            <div class="overflow-x-auto">
                <table class="w-full text-xs text-left text-slate-700 border border-slate-200 rounded-lg">
                    <thead class="text-xs uppercase bg-slate-800 text-white">
                        <tr>
                            <th class="px-3 py-3">Жыл</th>
                            <th class="px-3 py-3">ҚР Пациенттер</th>
                            <th class="px-3 py-3">Базалық Анықтау</th>
                            <th class="px-3 py-3 bg-amber-900">1. Консервативті (+4%p)</th>
                            <th class="px-3 py-3 bg-teal-900">2. Базалық (+7%p)</th>
                            <th class="px-3 py-3 bg-emerald-900">3. Оптимистік (+10%p)</th>
                            <th class="px-3 py-3">Базалық QALY Сақтау</th>
                        </tr>
                    </thead>
                    <tbody id="multiForecastTableBody" class="divide-y divide-slate-200 bg-white">
                        <!-- Dynamic Content via JS -->
                    </tbody>
                </table>
            </div>
        </section>

    </main>

    <script>
        // Historical Base Dataset
        const historicalData = [
            { year: 2018, cases_kz: 35200, cases_mg: 980, early_rate: 46.5 },
            { year: 2019, cases_kz: 36800, cases_mg: 1020, early_rate: 47.8 },
            { year: 2020, cases_kz: 32500, cases_mg: 890, early_rate: 44.2 },
            { year: 2021, cases_kz: 37100, cases_mg: 1050, early_rate: 49.1 },
            { year: 2022, cases_kz: 39000, cases_mg: 1110, early_rate: 50.5 },
            { year: 2023, cases_kz: 40500, cases_mg: 1150, early_rate: 51.2 },
            { year: 2024, cases_kz: 41800, cases_mg: 1190, early_rate: 52.0 },
            { year: 2025, cases_kz: 42500, cases_mg: 1220, early_rate: 52.8 },
        ];

        let earlyRateChartInstance = null;
        let savingsChartInstance = null;
        let qalyChartInstance = null;

        function toggleDeployGuide() {
            const section = document.getElementById('deployGuideSection');
            section.classList.toggle('hidden');
        }

        // Linear Regression Extrapolator
        function runLinearRegression(xArr, yArr, xTarget) {
            const n = xArr.length;
            let sumX = 0, sumY = 0, sumXY = 0, sumXX = 0;
            for (let i = 0; i < n; i++) {
                sumX += xArr[i];
                sumY += yArr[i];
                sumXY += xArr[i] * yArr[i];
                sumXX += xArr[i] * xArr[i];
            }
            const slope = (n * sumXY - sumX * sumY) / (n * sumXX - sumX * sumX);
            const intercept = (sumY - slope * sumX) / n;
            return slope * xTarget + intercept;
        }

        function computeScenarioMetrics(predKz, predMg, baseEarly, boostPercent) {
            const optEarly = parseFloat((baseEarly + boostPercent).toFixed(2));
            
            // Treatment costs per patient by stage distribution
            const costTrad = (baseEarly/100 * 0.385 * 850000) + (baseEarly/100 * 0.615 * 2100000) + ((100-baseEarly)/100 * 0.583 * 5200000) + ((100-baseEarly)/100 * 0.417 * 9800000);
            const costOpt = (optEarly/100 * 0.45 * 850000) + (optEarly/100 * 0.55 * 2100000) + ((100-optEarly)/100 * 0.60 * 5200000) + ((100-optEarly)/100 * 0.40 * 9800000);
            
            const unitSavings = costTrad - costOpt;
            const netSavingsBillion = ((predKz * unitSavings) - 500000000) / 1e9;
            const mgSavingsBillion = (predMg * unitSavings) / 1e9;
            const earlyCasesCount = Math.round(predKz * (optEarly / 100));

            // QALY Calculations: Quality of life index improvement (U1=0.88, U2=0.78, U3=0.58, U4=0.35)
            const qalyGain = Math.round(predKz * (boostPercent * 0.0055));

            return {
                optEarlyRate: optEarly,
                earlyCases: earlyCasesCount,
                netSavings: parseFloat(netSavingsBillion.toFixed(2)),
                mgSavings: parseFloat(mgSavingsBillion.toFixed(2)),
                qalyGained: qalyGain
            };
        }

        function runMultiScenarioForecast() {
            const targetYear = parseInt(document.getElementById('targetYear').value);

            const yearsArr = historicalData.map(d => d.year);
            const casesKzArr = historicalData.map(d => d.cases_kz);
            const casesMgArr = historicalData.map(d => d.cases_mg);
            const earlyArr = historicalData.map(d => d.early_rate);

            const predictions = [];
            for (let y = 2026; y <= targetYear; y++) {
                const predKz = Math.round(runLinearRegression(yearsArr, casesKzArr, y));
                const predMg = Math.round(runLinearRegression(yearsArr, casesMgArr, y));
                const baseEarly = parseFloat(runLinearRegression(yearsArr, earlyArr, y).toFixed(2));

                const scen1 = computeScenarioMetrics(predKz, predMg, baseEarly, 4.0);
                const scen2 = computeScenarioMetrics(predKz, predMg, baseEarly, 7.0);
                const scen3 = computeScenarioMetrics(predKz, predMg, baseEarly, 10.0);

                predictions.push({
                    year: y,
                    predKz: predKz,
                    predMg: predMg,
                    baseEarly: baseEarly,
                    scen1: scen1,
                    scen2: scen2,
                    scen3: scen3
                });
            }

            updateMultiScenarioUI(predictions);
        }

        function updateMultiScenarioUI(predictions) {
            const lastPred = predictions[predictions.length - 1];

            // Scenario 1 Update
            document.getElementById('scen1EarlyRate').innerText = lastPred.scen1.optEarlyRate + '%';
            document.getElementById('scen1EarlyCases').innerText = lastPred.scen1.earlyCases.toLocaleString('ru-RU') + ' пациент';
            document.getElementById('scen1Savings').innerText = lastPred.scen1.netSavings + ' млрд ₸';
            document.getElementById('scen1Qaly').innerText = lastPred.scen1.qalyGained.toLocaleString('ru-RU') + ' QALY';
            document.getElementById('scen1MgSavings').innerText = lastPred.scen1.mgSavings + ' млрд ₸';

            // Scenario 2 Update
            document.getElementById('scen2EarlyRate').innerText = lastPred.scen2.optEarlyRate + '%';
            document.getElementById('scen2EarlyCases').innerText = lastPred.scen2.earlyCases.toLocaleString('ru-RU') + ' пациент';
            document.getElementById('scen2Savings').innerText = lastPred.scen2.netSavings + ' млрд ₸';
            document.getElementById('scen2Qaly').innerText = lastPred.scen2.qalyGained.toLocaleString('ru-RU') + ' QALY';
            document.getElementById('scen2MgSavings').innerText = lastPred.scen2.mgSavings + ' млрд ₸';

            // Scenario 3 Update
            document.getElementById('scen3EarlyRate').innerText = lastPred.scen3.optEarlyRate + '%';
            document.getElementById('scen3EarlyCases').innerText = lastPred.scen3.earlyCases.toLocaleString('ru-RU') + ' пациент';
            document.getElementById('scen3Savings').innerText = lastPred.scen3.netSavings + ' млрд ₸';
            document.getElementById('scen3Qaly').innerText = lastPred.scen3.qalyGained.toLocaleString('ru-RU') + ' QALY';
            document.getElementById('scen3MgSavings').innerText = lastPred.scen3.mgSavings + ' млрд ₸';

            // Populate Table
            const tbody = document.getElementById('multiForecastTableBody');
            tbody.innerHTML = '';

            predictions.forEach(p => {
                tbody.innerHTML += `
                    <tr class="hover:bg-slate-50 border-b">
                        <td class="px-3 py-2.5 font-bold text-slate-900">${p.year} жыл</td>
                        <td class="px-3 py-2.5 font-semibold">${p.predKz.toLocaleString('ru-RU')}</td>
                        <td class="px-3 py-2.5 text-slate-500">${p.baseEarly}%</td>
                        <td class="px-3 py-2.5 bg-amber-50 font-bold text-amber-800">${p.scen1.optEarlyRate}% (${p.scen1.netSavings} млрд ₸)</td>
                        <td class="px-3 py-2.5 bg-teal-50 font-extrabold text-teal-900">${p.scen2.optEarlyRate}% (${p.scen2.netSavings} млрд ₸)</td>
                        <td class="px-3 py-2.5 bg-emerald-50 font-bold text-emerald-800">${p.scen3.optEarlyRate}% (${p.scen3.netSavings} млрд ₸)</td>
                        <td class="px-3 py-2.5 font-bold text-indigo-700">${p.scen2.qalyGained.toLocaleString('ru-RU')} QALY</td>
                    </tr>
                `;
            });

            renderMultiCharts(predictions);
        }

        function renderMultiCharts(predictions) {
            const histYears = historicalData.map(h => h.year);
            const predYears = predictions.map(p => p.year);
            const allYears = [...histYears, ...predYears];

            const histEarly = historicalData.map(h => h.early_rate);
            const baseEarlyLine = [...histEarly, ...predictions.map(p => p.baseEarly)];
            const scen1Line = [...Array(histYears.length).fill(null), ...predictions.map(p => p.scen1.optEarlyRate)];
            const scen2Line = [...Array(histYears.length).fill(null), ...predictions.map(p => p.scen2.optEarlyRate)];
            const scen3Line = [...Array(histYears.length).fill(null), ...predictions.map(p => p.scen3.optEarlyRate)];

            // 1. Early Rate Comparison Line Chart
            if (earlyRateChartInstance) earlyRateChartInstance.destroy();
            const ctx1 = document.getElementById('multiEarlyRateChart').getContext('2d');
            earlyRateChartInstance = new Chart(ctx1, {
                type: 'line',
                data: {
                    labels: allYears,
                    datasets: [
                        { label: 'Тарихи & Базалық Трэнд', data: baseEarlyLine, borderColor: '#64748b', borderWidth: 2 },
                        { label: '1-Сценарий (+4%p)', data: scen1Line, borderColor: '#f59e0b', borderWidth: 2, borderDash: [4, 4] },
                        { label: '2-Сценарий (+7%p)', data: scen2Line, borderColor: '#14b8a6', borderWidth: 3 },
                        { label: '3-Сценарий (+10%p)', data: scen3Line, borderColor: '#10b981', borderWidth: 2, borderDash: [2, 2] }
                    ]
                },
                options: { responsive: true, maintainAspectRatio: false }
            });

            // 2. Savings Bar Chart
            if (savingsChartInstance) savingsChartInstance.destroy();
            const ctx2 = document.getElementById('multiSavingsChart').getContext('2d');
            savingsChartInstance = new Chart(ctx2, {
                type: 'bar',
                data: {
                    labels: predYears,
                    datasets: [
                        { label: '1. Консервативті (Млрд ₸)', data: predictions.map(p => p.scen1.netSavings), backgroundColor: '#f59e0b' },
                        { label: '2. Базалық (Млрд ₸)', data: predictions.map(p => p.scen2.netSavings), backgroundColor: '#14b8a6' },
                        { label: '3. Оптимистік (Млрд ₸)', data: predictions.map(p => p.scen3.netSavings), backgroundColor: '#10b981' }
                    ]
                },
                options: { responsive: true, maintainAspectRatio: false }
            });

            // 3. QALY Comparison Chart
            if (qalyChartInstance) qalyChartInstance.destroy();
            const ctx3 = document.getElementById('qalyComparisonChart').getContext('2d');
            qalyChartInstance = new Chart(ctx3, {
                type: 'bar',
                data: {
                    labels: predYears,
                    datasets: [
                        { label: '1-Сценарий QALY', data: predictions.map(p => p.scen1.qalyGained), backgroundColor: '#fbbf24' },
                        { label: '2-Сценарий QALY', data: predictions.map(p => p.scen2.qalyGained), backgroundColor: '#6366f1' },
                        { label: '3-Сценарий QALY', data: predictions.map(p => p.scen3.qalyGained), backgroundColor: '#34d399' }
                    ]
                },
                options: { responsive: true, maintainAspectRatio: false }
            });

            // 4. Plotly Cost-Effectiveness Scatter
            const lastP = predictions[predictions.length - 1];
            const plotlyData = [{
                x: [lastP.scen1.qalyGained, lastP.scen2.qalyGained, lastP.scen3.qalyGained],
                y: [-lastP.scen1.netSavings, -lastP.scen2.netSavings, -lastP.scen3.netSavings],
                mode: 'markers+text',
                type: 'scattergl',
                text: ['1. Консервативті', '2. Базалық', '3. Оптимистік'],
                textposition: 'top center',
                marker: { size: 14, color: ['#f59e0b', '#14b8a6', '#10b981'] }
            }];

            const plotlyLayout = {
                margin: { t: 20, r: 20, l: 50, b: 50 },
                xaxis: { title: 'Пайда: Δ QALY (Өмір Сапасы)' },
                yaxis: { title: 'Шығын: Δ C (Таза Үнем, Млрд ₸)' }
            };

            Plotly.newPlot('plotlyIcePlaneMulti', plotlyData, plotlyLayout, {responsive: true, displayModeBar: false});
        }

        window.onload = () => { runMultiScenarioForecast(); };
    </script>
</body>
</html>
