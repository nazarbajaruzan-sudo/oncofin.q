                    <select id="targetYear" onchange="runMultiScenarioForecast()" class="bg-slate-800 text-teal-300 font-bold text-base px-4 py-2.5 rounded-lg border border-teal-500/50 focus:outline-none focus:border-teal-400">
                        <option value="2026">2026 жыл</option>
                        <option value="2027">2027 жыл</option>
                        <option value="2028">2028 жыл</option>
                        <option value="2029">2029 жыл</option>
                        <option value="2030" selected>2030 жыл (Мақсатты Жыл)</option>
                    </select>
                </div>
            </div>

            <!-- 3 Scenario Detailed Comparison Cards -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-4 border-t border-slate-800">
                
                <!-- Scenario 1: Conservative -->
                <div class="p-5 bg-slate-800/90 rounded-xl border border-amber-500/40 space-y-3 relative overflow-hidden">
                    <div class="absolute top-0 right-0 bg-amber-500 text-slate-900 text-[10px] font-extrabold px-3 py-1 rounded-bl">
                        1-Сценарий
                    </div>
                    <h4 class="text-base font-bold text-amber-300">Консервативті (+4.0%p)</h4>
                    <p class="text-[11px] text-slate-400">Базалық ерте анықтауға +4.0%p қосылады</p>
                    
                    <div class="space-y-2 pt-2 text-xs">
                        <div class="flex justify-between border-b border-slate-700/60 pb-1">
                            <span class="text-slate-400">Ерте Анықтау Дәрежесі:</span>
